---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { estudios, fechaLarga } from '../../lib';
import { url } from '../../config';

export async function getStaticPaths() {
  return (await estudios()).map((estudio) => ({ params: { id: estudio.id }, props: { estudio } }));
}
const { estudio } = Astro.props;
const d = estudio.data;
const { Content } = await render(estudio);
---
<Base titulo={d.titulo} descripcion={d.resumen} seccion="estudios">
  <header class="encabezado-articulo">
    <div class="contenedor">
      <a class="mono" style="font-size:14px" href={url('/estudios/')}>← Estudios</a>
      <div class="etiqueta">{d.tema}{d.estado === 'en curso' ? ' · en curso' : ''}</div>
      <h1>{d.titulo}</h1>
      <p class="resumen">{d.resumen}</p>
      <div class="mono tenue" style="font-size:13px">{d.lugar} · {fechaLarga(d.fecha)}</div>
      <div class="ficha">
        <div><div class="k">Periodo</div><div class="v">{d.periodo ?? '—'}</div></div>
        <div><div class="k">Área</div><div class="v">{d.area ?? '—'}</div></div>
        <div><div class="k">Fuentes</div><div class="v">{d.fuentes ?? '—'}</div></div>
      </div>
    </div>
  </header>
  <article class="prosa"><Content /></article>
</Base>

<script>
  // Barrido comparativo: mueve la línea divisoria según el control deslizante.
  document.querySelectorAll<HTMLElement>('[data-barrido]').forEach((caja) => {
    const control = caja.querySelector<HTMLInputElement>('input[type="range"]');
    if (!control) return;
    const actualizar = () => caja.style.setProperty('--pos', `${control.value}%`);
    control.addEventListener('input', actualizar);
    actualizar();
  });

  // Comparador de capas: cambia la imagen de cada lado según la lista elegida.
  document.querySelectorAll<HTMLElement>('[data-comparador]').forEach((comp) => {
    const leyendas = comp.querySelectorAll<HTMLElement>('[data-leyenda]');
    const refrescarLeyendas = () => {
      const elegidas = Array.from(comp.querySelectorAll<HTMLSelectElement>('select[data-capa]')).map((s) => s.value);
      leyendas.forEach((l) => (l.hidden = !elegidas.includes(l.dataset.leyenda || '')));
    };
    comp.querySelectorAll<HTMLSelectElement>('select[data-capa]').forEach((sel) => {
      const lado = sel.dataset.capa;
      const img = comp.querySelector<HTMLImageElement>(`img[data-lado="${lado}"]`);
      const etq = comp.querySelector<HTMLElement>(`[data-etq="${lado}"]`);
      if (!img) return;
      const carpeta = img.getAttribute('src')!.replace(/[^/]*$/, '');
      sel.addEventListener('change', () => {
        const opcion = sel.selectedOptions[0];
        img.src = carpeta + sel.value;
        img.alt = opcion.dataset.alt || opcion.text;
        if (etq) etq.textContent = opcion.dataset.corto || opcion.text;
        refrescarLeyendas();
      });
    });
    refrescarLeyendas();
  });
</script>
