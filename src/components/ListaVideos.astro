---
import type { CollectionEntry } from 'astro:content';
interface Props { videos: CollectionEntry<'videos'>[] }
const { videos } = Astro.props;
const tipos = { original: 'Video original', ia: 'Video creado con IA' };
---
{videos.length === 0 ? (
  <p class="vacio">Aún no hay videos publicados.</p>
) : (
  <div class="videos">
    {videos.map((v) => (
      <article>
        <div class="pantalla">
          {v.data.youtube ? (
            <iframe src={`https://www.youtube-nocookie.com/embed/${v.data.youtube}`} title={v.data.titulo} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          ) : (
            <span class="play"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5l12 7-12 7z" fill="#EDF0EA"></path></svg></span>
          )}
        </div>
        <div class="etiqueta">{tipos[v.data.tipo]}</div>
        <h3>{v.data.titulo}</h3>
        {v.data.descripcion && <p>{v.data.descripcion}</p>}
      </article>
    ))}
  </div>
)}
